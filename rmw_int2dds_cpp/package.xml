<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rmw_int2dds_cpp</name>
  <version>0.1.5</version>
  <description>
    ROS 2 middleware (RMW) implementation that binds the int2DDS DDS/RTPS
    middleware to the ROS 2 rmw interface.
  </description>

  <maintainer email="int2dds@int2.us">Jungsup Lee</maintainer>

  <license>Apache-2.0</license>

  <url type="repository">https://github.com/IntellectusCorp/rmw_int2dds</url>
  <url type="bugtracker">https://github.com/IntellectusCorp/rmw_int2dds/issues</url>
  <url type="website">https://github.com/IntellectusCorp/int2DDS</url>

  <author email="int2dds@int2.us">Intellectus Corp.</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core RMW interface and shared DDS utilities -->
  <depend>rmw</depend>
  <depend>rmw_dds_common</depend>
  <depend>rcutils</depend>
  <depend>rosidl_runtime_c</depend>
  <depend>rosidl_runtime_cpp</depend>

  <!-- Type support packages. The introspection ones carry the type support this
       RMW consumes; rosidl_typesupport_c/cpp provide the dispatch layer that
       CMakeLists.txt find_package()es directly. Those two currently arrive anyway
       as apt dependencies of std_msgs, but leaning on that is exactly how the ROS
       build farm breaks - it installs only what is declared here. -->
  <depend>rosidl_typesupport_introspection_c</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>
  <depend>rosidl_typesupport_c</depend>
  <depend>rosidl_typesupport_cpp</depend>

  <!-- Message type used by the event smoke/validation executables under test/ -->
  <depend>std_msgs</depend>

  <!-- Prebuilt int2DDS FFI library (downloaded + exported by the vendor pkg).
       int2dds_ffi_vendor lives in this repository, so bloom versions the two
       packages in lockstep and a version range here would only ever compare a
       package against itself. The FFI version that actually gets fetched is
       pinned in one place: INT2DDS_FFI_VERSION in int2dds_ffi_vendor/CMakeLists.txt. -->
  <depend>int2dds_ffi_vendor</depend>

  <!-- Lint / test. ament_cmake_cpplint and ament_cmake_flake8 come along with
       ament_lint_common, but CMakeLists.txt find_package()es them directly in
       order to call ament_cpplint()/ament_flake8() with explicit paths, so they
       are declared rather than assumed. -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_uncrustify</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <!-- Mark this package as an RMW implementation so rmw_implementation builds it -->
  <member_of_group>rmw_implementation_packages</member_of_group>

  <!-- rosdoc2 documentation config -->
  <export>
    <build_type>ament_cmake</build_type>
    <rmw_implementation>rmw_int2dds_cpp</rmw_implementation>
    <rosdoc2>rosdoc2.yaml</rosdoc2>
  </export>
</package>
